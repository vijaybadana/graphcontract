{
  "name": "graphcontract",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "local:setup": "node scripts/local-runtime.mjs setup",
    "local:run": "node scripts/local-runtime.mjs run",
    "local:status": "node scripts/local-runtime.mjs status",
    "local:reload": "node scripts/local-runtime.mjs reload",
    "local:restart": "node scripts/local-runtime.mjs restart",
    "local:stop": "node scripts/local-runtime.mjs stop",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:dev": "npm run lint && npm run test:unit",
    "test:integration": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.11.5",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  },
  "type": "module"
